<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>GestionNominas.Persistence</RootNamespace>
    <NoWarn>$(NoWarn);CS8601</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MySql.Data" Version="26.10.0" />
    <!-- AgenteBD, facilitado por el profesor, es internal: el dominio necesita acceder a él. -->
    <InternalsVisibleTo Include="GestionNominas.Domain" />
  </ItemGroup>

</Project>
